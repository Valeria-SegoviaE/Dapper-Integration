{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Orders.Api",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build Orders.Api",
      "program": "${workspaceFolder}/bin/Debug/net10.0/Orders.Api.dll",
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "https://localhost:7213;http://localhost:5193"
      }
    }
  ]
}